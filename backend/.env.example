# =============================================================================
# BIẾN MÔI TRƯỜNG - BACKEND (SPRING BOOT) — FILE MẪU (EXAMPLE)
# Sao chép file này thành .env và điền giá trị thực
# File .env KHÔNG được commit lên Git (đã được thêm vào .gitignore)
# =============================================================================

# --- CƠ SỞ DỮ LIỆU (DATABASE) ---
DB_URL=jdbc:mysql://localhost:3306/stay?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=

# --- CLOUDINARY (LƯU TRỮ ẢNH) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- RESEND EMAIL SERVICE ---
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=YourApp <noreply@yourdomain.com>

# --- TELEGRAM BOT (SAO LƯU) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
TELEGRAM_BACKUP_ENABLED=true

# --- GOOGLE GEMINI AI ---
GEMINI_API_KEY=your_gemini_api_key

# --- DOMAIN / URL ỨNG DỤNG ---
APP_DOMAIN=https://stayaway.io.vn
APP_FRONTEND_URL=https://stayaway.io.vn
