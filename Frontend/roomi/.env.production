# ===================================================================
# PRODUCTION ENVIRONMENT VARIABLES — Roomi Frontend
# ===================================================================
# KHÔNG commit file này với giá trị thật lên Git!
# Giá trị thật phải được set trong:
#   - GitHub Secrets: VITE_API_BASE_URL_PROD (cho CI/CD Docker build)
#   - Hoặc truyền qua docker build --build-arg VITE_API_BASE_URL=...
#
# File này CHỈ dùng làm documentation / local reference.
# ===================================================================

# URL backend API production (không có trailing slash)
# Ví dụ: https://api.roomi.com/api/v1  hoặc  http://123.45.67.89:8080/api/v1
# Khi dùng trong Docker Compose + Nginx proxy: có thể để /api/v1 (relative)
VITE_API_BASE_URL=https://your-backend-domain.com/api/v1
