# ===================================================================
# PRODUCTION ENVIRONMENT VARIABLES — Roomi Frontend
# ===================================================================
# Khi build Docker image cho production:
#   - GitHub Actions CD pipeline inject VITE_API_BASE_URL qua --build-arg
#   - Dùng relative path /api/v1 vì Nginx trong Frontend container sẽ
#     proxy_pass các request /api/ → backend:8080/api/
#
# KHÔNG cần thay đổi file này — GitHub Actions sẽ override lúc build.
# ===================================================================

# URL backend API production
# Dùng /api/v1 (relative path) — Nginx proxy sẽ route đến backend container
VITE_API_BASE_URL=/api/v1
