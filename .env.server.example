# =============================================================================
# .env.server.example — Template file .env cần tạo trên VPS
# =============================================================================
# Sao chép file này thành .env trên VPS:
#   cp .env.server.example .env
# Sau đó điền đúng giá trị thật vào .env
# KHÔNG commit file .env lên Git!
# =============================================================================

# GitHub repository (lowercase, định dạng: username/repo-name)
# Dùng để xây dựng đường dẫn image GHCR
# Ví dụ: manh-dev/roomi  hoặc  your-org/roomi
GITHUB_REPOSITORY=your-username/roomi

# Tag Docker image muốn dùng (mặc định: latest)
IMAGE_TAG=latest

# Mật khẩu Database MySQL (nên đổi thành password mạnh)
DB_USERNAME=root
DB_PASSWORD=changeme_strong_password_here

# ── Thông tin thêm (tùy chọn) ──────────────────────────────────────────────
# Nếu muốn Nginx VPS host biết thêm thông tin:
# DOMAIN=roomi.website
